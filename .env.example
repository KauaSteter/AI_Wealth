# AI Wealth Advisor - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env with real credentials to version control!

# ==================== SERVER ====================
SERVER_PORT=8080
SERVER_MODE=release
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s

# ==================== DATABASE ====================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=[REDACTED]
DB_NAME=ai_wealth_advisor
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300

# ==================== REDIS ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5

# ==================== JWT ====================
JWT_SECRET=[REDACTED]
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
JWT_ISSUER=ai-wealth-advisor
JWT_AUDIENCE=ai-wealth-advisor-users

# ==================== OPENAI ====================
OPENAI_API_KEY=[REDACTED]
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60s

# ==================== MARKET DATA ====================
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_API_KEY=
MARKET_DATA_CACHE_TTL=900
MARKET_DATA_RATE_LIMIT=100

# ==================== EMAIL (Optional) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=[REDACTED]
SMTP_PASSWORD=[REDACTED]
SMTP_FROM=AI Wealth Advisor <noreply@aiwealth.com>
SMTP_USE_TLS=true

# ==================== WEBHOOK (Optional) ====================
WEBHOOK_URL=
WEBHOOK_SECRET=[REDACTED]

# ==================== CORS ====================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend-domain.com

# ==================== FRONTEND ====================
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080
VITE_APP_NAME=AI Wealth Advisor

# ==================== PGADMIN (Optional) ====================
PGADMIN_EMAIL=admin@aiwealth.com
PGADMIN_PASSWORD=[REDACTED]
PGADMIN_PORT=5050

# ==================== FRONTEND PORT (Docker) ====================
FRONTEND_PORT=80
